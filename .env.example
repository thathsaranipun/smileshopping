# Copy to .env.local for local dev. On Vercel add these under Project → Settings → Environment Variables.
# Everything else (products, prices, WhatsApp number) lives in the /data folder — no database is used.

# Public site URL (used for the sitemap and share links)
NEXT_PUBLIC_SITE_URL=https://smileshopping.vercel.app

# Optional tracking
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA_ID=
